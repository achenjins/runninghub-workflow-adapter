{
  "manifest_version": 2,
  "plugin_type": "media",
  "id": "github.achenjins.runninghub-workflow-adapter",
  "version": "1.0.1",
  "name": "麦麦画师 · RunningHub",
  "description": "让麦麦亲手给你画画：从一句话文生图，到多参考图 / 视频生成，统统自动完成并把成品发回聊天。支持自定义工作流、自己优化成本、AI 扩写提示词和限流防刷。仅适配 NapCat / QQ。",
  "author": {
    "name": "achenjins",
    "url": "https://github.com/achenjins"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/achenjins/runninghub-workflow-adapter",
    "homepage": "https://github.com/achenjins/runninghub-workflow-adapter",
    "documentation": "https://github.com/achenjins/runninghub-workflow-adapter/blob/main/README.md",
    "issues": "https://github.com/achenjins/runninghub-workflow-adapter/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "requests",
      "version_spec": ">=2.31.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "send.custom",
    "api.call",
    "llm.generate",
    "maisaka.context.append",
    "maisaka.proactive.trigger"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.jpg"
    }
  }
}