{
  "manifest_version": 2,
  "id": "rh-workflow-adapter",
  "version": "1.0.0",
  "name": "RunningHub 通用工作流插件",
  "description": "仅适配 NapCat 的 QQ（其余平台未测试，可能用不了）。通过配置适配 RunningHub 的大部分工作流：可配置多个工作流，每个工作流可自由增加输入节点（节点 ID / 字段名 / 默认值），命令、工具与公开 API 三种触发方式，任务完成后自动发送结果，支持自动撤回。",
  "author": {
    "name": "achenjins",
    "url": "https://github.com/achenjins"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/achenjins/runninghub-workflow-adapter",
    "homepage": "https://github.com/achenjins/runninghub-workflow-adapter",
    "documentation": "https://github.com/achenjins/runninghub-workflow-adapter/blob/main/README.md",
    "issues": "https://github.com/achenjins/runninghub-workflow-adapter/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "requests",
      "version_spec": ">=2.31.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "api.call",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}