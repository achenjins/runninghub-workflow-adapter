{
  "manifest_version": 2,
  "id": "github.achenjins.runninghub-workflow-adapter",
  "version": "1.0.0",
  "name": "RunningHub 通用工作流插件",
  "description": "让 MaiBot 操作你的账号跑 RunningHub 工作流：文生图、图生图、图生视频等等，结果自动发回。支持配置多工作流、工作流自动识别、LLM 提示词扩写与访问控制，仓库内含一个文生图工作流配置教程。仅适配 NapCat 的 QQ 消息平台。",
  "author": {
    "name": "achenjins",
    "url": "https://github.com/achenjins"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/achenjins/runninghub-workflow-adapter",
    "homepage": "https://github.com/achenjins/runninghub-workflow-adapter",
    "documentation": "https://github.com/achenjins/runninghub-workflow-adapter/blob/main/README.md",
    "issues": "https://github.com/achenjins/runninghub-workflow-adapter/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "requests",
      "version_spec": ">=2.31.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "send.custom",
    "api.call",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}